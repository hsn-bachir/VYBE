APP_NAME="VYBE Movie Catalog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vybe_movies
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Never commit a real service token or TMDB credential.
CATALOG_INTERNAL_TOKEN=
TMDB_TOKEN=
CATALOG_METADATA_TTL_SECONDS=604800
CATALOG_RANKING_TTL_SECONDS=900
CATALOG_REFRESH_COOLDOWN_SECONDS=30
TMDB_CONNECT_TIMEOUT_SECONDS=2
TMDB_REQUEST_TIMEOUT_SECONDS=5
