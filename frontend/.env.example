VITE_API_URL=http://localhost:8000
VITE_AUTH_IDENTITY_PROVIDER=legacy
# Google/GitHub use the same Firebase web app; enable providers in Firebase Console.
# Keep GitHub Client Secret in Firebase/GitHub configuration, never in VITE_*.
# For Firebase mode, configure Authentication Templates custom action URL as this SPA origin/auth/action.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
